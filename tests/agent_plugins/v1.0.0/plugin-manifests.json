[
  {
    "name": "minimal manifest",
    "accepted": true,
    "diagnostics": [],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "minimal"
    }
  },
  {
    "name": "manifest with optional fields and client extension",
    "accepted": true,
    "diagnostics": [],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "review-tools",
      "version": "1.2.3",
      "description": "Review source changes.",
      "author": {
        "name": "Example",
        "email": "dev@example.invalid",
        "url": "https://example.invalid"
      },
      "homepage": "https://example.invalid/home",
      "repository": "https://example.invalid/repo",
      "license": "MIT",
      "keywords": [
        "review",
        "testing"
      ],
      "extensions": {
        "com.veasel.code": {
          "display_name": "Review tools"
        }
      }
    }
  },
  {
    "name": "unknown root property is ignored",
    "accepted": true,
    "diagnostics": [
      "unknown top-level field"
    ],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "future-field",
      "futureField": {
        "opaque": true
      }
    }
  },
  {
    "name": "non-object extensions is ignored with a diagnostic",
    "accepted": true,
    "diagnostics": [
      "non-object extensions"
    ],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "bad-extensions",
      "extensions": []
    }
  },
  {
    "name": "unsupported Veasel extension field is ignored",
    "accepted": true,
    "diagnostics": [
      "Ignoring unsupported Veasel extension field `channel`"
    ],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "extra-extension-field",
      "extensions": {
        "com.veasel.code": {
          "display_name": "Review tools",
          "channel": "stable"
        }
      }
    }
  },
  {
    "name": "invalid Veasel extension label is ignored",
    "accepted": true,
    "diagnostics": [
      "Ignoring invalid Veasel extension display_name"
    ],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "bad-extension-label",
      "extensions": {
        "com.veasel.code": {
          "display_name": "bad\nname"
        }
      }
    }
  },
  {
    "name": "unknown extension namespace stays opaque",
    "accepted": true,
    "diagnostics": [],
    "document": {
      "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
      "name": "opaque-extension",
      "extensions": {
        "vendor.example": [
          "opaque",
          {
            "nested": true
          }
        ]
      }
    }
  },
